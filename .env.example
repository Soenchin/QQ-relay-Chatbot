# ─── DeepSeek API（直调模式必填） ───
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── SnowLuma / NapCat WebSocket ───
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=your-token-here

# ─── 机器人名称（显示在日志/管道/WebUI 中） ───
BOT_NAME=QQ Bot

# ─── 最高权限QQ号配置 ───
# 0 表示未指定主人，首次配置可在 WebUI 填写
MASTER_QQ=0

# ─── 群模式分流 ───
# GROUP_MODE: JSON 字典，key=群号(字符串)，value="direct"(直调) 或 "pipe"(管道)
# 不在字典里的群走 FALLBACK_MODE（可选值: direct / pipe）
# 示例: GROUP_MODE={"123456789":"direct","987654321":"pipe"}
GROUP_MODE=
FALLBACK_MODE=direct

# ─── 管道读图（可选）───
# 开启读图的群号 JSON 数组；默认空=全部关闭。保存后尽量热更新
# 示例: GROUP_VISION=[123456789]
GROUP_VISION=

# ─── Claude CLI 路径（pipe 模式用）───
#一般是C:\Users\用户名\AppData\Roaming\npm\claude.cmd 
CLAUDE_CMD=claude.cmd

# ─── 数据目录（默认项目旁 memory/；相对路径以数据根为准，不以工作目录为准） ───
# 可通过启动参数 --data-dir 指定独立数据根；不会自动迁移旧文件
MEM_DIR=./memory
# Claude 可读取的工作目录，不要指向整个磁盘或私人文档
PIPE_ADD_DIR=./memory

# ─── 图床端口 ───
MEME_SERVER_PORT=8801

# ─── WebUI（也可用 --webui 参数强制开启） ───
# 首次可运行 python webui.py 打开控制台；默认不连接 QQ，保存后点击“启动中继”
# 机器人设置可按钮重启应用；WebUI 地址/端口与日志目录需退出并重开控制台
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8800
